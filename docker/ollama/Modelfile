# Core model for Ollama. Must load the same Model file as docker/localai/qwen3.5-9b.yaml.
FROM /models/Qwen3.5-9B-Q4_K_M.gguf
PARAMETER num_ctx 16384
# Ollama's OpenAI-compatible endpoint ignores these in a request, so they are
# pinned here, identically in docker/localai/qwen3.5-9b.yaml
# (harness/sampling.py RUNTIME_PINNED). The harness sends the rest of the
# Sampling profile (temperature, top_p, presence_penalty, seed) with every request.
PARAMETER top_k 20
PARAMETER min_p 0.0
PARAMETER repeat_penalty 1.0
